rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/grupos/$(groupId));
    }

    function isGroupCreator(groupId) {
      return signedIn() && groupDoc(groupId).data.criadorId == request.auth.uid;
    }

    function isCurrentGroupCreatorForUser(userId) {
      return signedIn()
        && resource.data.grupoId is string
        && groupDoc(resource.data.grupoId).data.criadorId == request.auth.uid;
    }

    function validUserCreate() {
      return request.resource.data.keys().hasOnly([
        'email',
        'nome',
        'entradaEm',
        'grupoId',
        'papel',
        'dataNascimento',
        'genero',
        'nacionalidade',
        'cep',
        'atualizadoEm'
      ]);
    }

    function validUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'email',
        'nome',
        'entradaEm',
        'grupoId',
        'papel',
        'dataNascimento',
        'genero',
        'nacionalidade',
        'cep',
        'atualizadoEm'
      ]);
    }

    match /usuarios/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && validUserCreate();
      allow update: if (isSelf(userId) && validUserUpdate())
        || (
          isCurrentGroupCreatorForUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grupoId'])
        );
    }

    match /grupos/{groupId} {
      allow read, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.criadorId == request.auth.uid;
      allow update, delete: if isGroupCreator(groupId);

      match /membros/{memberId} {
        allow read, list: if signedIn();
        allow create, update: if signedIn();
        allow delete: if isGroupCreator(groupId);
      }

      match /dependentes/{dependentId} {
        allow read, list: if signedIn();
        allow create, update, delete: if isGroupCreator(groupId);
      }

      match /tarefas/{taskId} {
        allow read, list, create, update, delete: if signedIn();
      }
    }
  }
}
